<?xml version="1.0"?>
<package format="3">
  <name>spark_3dsg_pipeline</name>
  <version>0.1.0</version>
  <description>Dockerized launch and configuration integration for Hydra/Khronos.</description>
  <maintainer email="maintainers@example.invalid">spark-3dsg-pipeline maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>hydra_ros</exec_depend>
  <exec_depend>hydra_visualizer</exec_depend>
  <exec_depend>khronos_ros</exec_depend>
  <exec_depend>kimera_pgmo_rviz</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>semantic_inference_ros</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

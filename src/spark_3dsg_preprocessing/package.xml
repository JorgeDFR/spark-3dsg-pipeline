<?xml version="1.0"?>
<package format="3">
  <name>spark_3dsg_preprocessing</name>
  <version>0.1.0</version>
  <description>Sensor normalization and odometry backend integration for spark-3dsg-pipeline.</description>
  <maintainer email="maintainers@example.invalid">spark-3dsg-pipeline maintainers</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>depth_image_proc</exec_depend>

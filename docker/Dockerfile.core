FROM osrf/ros:jazzy-desktop-full

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_UID=1000
ARG USER_GID=1000
ENV ROS_DISTRO=jazzy \
    ROS_WS=/home/spark/ros_ws \
    PIPELINE_ROOT=/home/spark/spark-3dsg-pipeline \
    PYTHONUNBUFFERED=1

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      libcli11-dev \
      libeigen3-dev \
      libgoogle-glog-dev \
      libzmq3-dev \
      nlohmann-json3-dev \
      pipx \
      python3-pip \
      python3-pytest \
      python3-venv \
      python3-vcstool \
      python3-yaml \
      ros-dev-tools \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true && rosdep update --rosdistro jazzy

WORKDIR ${ROS_WS}
COPY dependencies/locks/adt4.lock.repos /tmp/adt4.lock.repos
RUN mkdir -p src && vcs import src --workers 1 < /tmp/adt4.lock.repos

COPY src/spark_3dsg_pipeline src/spark_3dsg_pipeline

RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y --rosdistro jazzy \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/build_workspace.sh /tmp/build_workspace.sh
RUN /tmp/build_workspace.sh ${ROS_WS}

WORKDIR ${PIPELINE_ROOT}
COPY . ${PIPELINE_ROOT}

RUN chmod +x docker/*.sh scripts/*.sh scripts/*.py \
    && python3 -c "import yaml" \
    && bash -lc "source ${ROS_WS}/install/setup.bash && ros2 pkg prefix hydra_ros && ros2 pkg prefix khronos_ros && ros2 pkg prefix spark_3dsg_pipeline && python3 -c 'import spark_dsg'"

# Keep bind-mounted model and output files owned by the invoking host user.
# Non-unique IDs make this robust when a base image already contains UID/GID 1000.
RUN set -eux; \
    if getent group spark >/dev/null; then \
      groupmod --non-unique --gid "${USER_GID}" spark; \
    else \
      groupadd --non-unique --gid "${USER_GID}" spark; \
    fi; \
    if id spark >/dev/null 2>&1; then \
      usermod --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home /home/spark --shell /bin/bash spark; \
    else \
      useradd --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home-dir /home/spark --create-home --shell /bin/bash spark; \
    fi; \
    install -d -o "${USER_UID}" -g "${USER_GID}" \
      /home/spark/.cache /home/spark/data /home/spark/models /home/spark/output; \
    chown -R "${USER_UID}:${USER_GID}" "${ROS_WS}" "${PIPELINE_ROOT}" /home/spark

ENV HOME=/home/spark \
    XDG_CACHE_HOME=/home/spark/.cache \
    DATA_TOOLS_ENV=/home/spark/.venvs/data-tools \
    PATH=/home/spark/.venvs/data-tools/bin:${PATH}
USER spark

RUN python3 -m venv --system-site-packages "${DATA_TOOLS_ENV}" \
    && "${DATA_TOOLS_ENV}/bin/pip" install --no-cache-dir --upgrade pip \
    && "${DATA_TOOLS_ENV}/bin/pip" install --no-cache-dir \
         --requirement "${PIPELINE_ROOT}/dependencies/data-tools.requirements.txt" \
    && rosbags-convert --help >/dev/null

ENTRYPOINT ["/home/spark/spark-3dsg-pipeline/docker/ros_entrypoint.sh"]
CMD ["bash"]

# syntax=docker/dockerfile:1.7

# Keep the core image deliberately boring: one ROS development image contains
# the compiler, exact-SHA upstream source, installed workspace, tests, and RViz.
# This is larger than a split runtime image, but much easier to build and debug.
ARG ROS_IMAGE=osrf/ros:jazzy-desktop-full
FROM ${ROS_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive
ARG USER_UID=1000
ARG USER_GID=1000
ENV ROS_DISTRO=jazzy \
    ROS_WS=/home/spark/ros_ws \
    PIPELINE_ROOT=/home/spark/spark-3dsg-pipeline \
    PYTHONUNBUFFERED=1 \
    DATA_TOOLS_ENV=/home/spark/.venvs/data-tools \
    PATH=/home/spark/.venvs/data-tools/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      libcli11-dev \
      libeigen3-dev \
      libgoogle-glog-dev \
      libzmq3-dev \
      nlohmann-json3-dev \
      pipx \
      python3-pip \
      python3-pytest \
      python3-venv \
      python3-vcstool \
      python3-yaml \
      ros-dev-tools \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-rosbag2-storage-mcap \
    && rm -rf /var/lib/apt/lists/*

RUN rosdep init 2>/dev/null || true \
    && rosdep update --rosdistro ${ROS_DISTRO}

WORKDIR ${ROS_WS}
COPY dependencies/locks/v1.lock.repos /tmp/v1.lock.repos
COPY scripts/shell/bootstrap_dependencies.sh /tmp/bootstrap_dependencies.sh
RUN /tmp/bootstrap_dependencies.sh ${ROS_WS}/src /tmp/v1.lock.repos

# Keeping the local package in a separate layer lets edits rebuild only the
# workspace, while an unchanged dependency lock keeps the expensive fetch.
COPY src/spark_3dsg_pipeline src/spark_3dsg_pipeline
RUN apt-get update \
    && rosdep install --from-paths src --ignore-src -r -y \
         --rosdistro ${ROS_DISTRO} \
    && rm -rf /var/lib/apt/lists/*

COPY scripts/shell/build_workspace.sh /tmp/build_workspace.sh
RUN SPARK_BUILD_TESTING=OFF SPARK_SYMLINK_INSTALL=ON \
    /tmp/build_workspace.sh ${ROS_WS}

WORKDIR ${PIPELINE_ROOT}
COPY . ${PIPELINE_ROOT}

RUN chmod +x docker/*.sh scripts/shell/*.sh scripts/python/*.py \
    && python3 -m venv --system-site-packages "${DATA_TOOLS_ENV}" \
    && "${DATA_TOOLS_ENV}/bin/pip" install --no-cache-dir --upgrade pip \
    && "${DATA_TOOLS_ENV}/bin/pip" install --no-cache-dir \
         --requirement dependencies/data-tools.requirements.txt \
    && rosbags-convert --help >/dev/null \
    && set +u \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && source ${ROS_WS}/install/setup.bash \
    && set -u \
    && ros2 pkg prefix hydra_ros \
    && ros2 pkg prefix khronos_ros \
    && ros2 pkg prefix spark_3dsg_pipeline \
    && python3 -c 'import spark_dsg'

# Match bind-mounted data/model/output ownership to the invoking host user.
RUN set -eux; \
    if getent group spark >/dev/null; then \
      groupmod --non-unique --gid "${USER_GID}" spark; \
    else \
      groupadd --non-unique --gid "${USER_GID}" spark; \
    fi; \
    if id spark >/dev/null 2>&1; then \
      usermod --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home /home/spark --shell /bin/bash spark; \
    else \
      useradd --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home-dir /home/spark --create-home --shell /bin/bash spark; \
    fi; \
    install -d -o "${USER_UID}" -g "${USER_GID}" \
      /home/spark /home/spark/.cache /home/spark/.ros \
      /home/spark/data /home/spark/models /home/spark/output; \
    chown -R "${USER_UID}:${USER_GID}" \
      "${ROS_WS}" "${PIPELINE_ROOT}" /home/spark/.venvs

ENV HOME=/home/spark \
    XDG_CACHE_HOME=/home/spark/.cache
USER spark
RUN test -w "${HOME}" && test -w "${HOME}/.ros"

ENTRYPOINT ["/home/spark/spark-3dsg-pipeline/docker/ros_entrypoint.sh"]
CMD ["bash"]

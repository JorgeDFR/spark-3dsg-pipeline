# syntax=docker/dockerfile:1.7

# Keep the full development/test capability. Assemble the workspace once with
# its final ownership instead of duplicating it with a later recursive chown.
ARG ROS_IMAGE=osrf/ros:jazzy-desktop-full
FROM ${ROS_IMAGE} AS base

ARG DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH
ENV ROS_DISTRO=jazzy \
    ROS_WS=/home/spark/ros_ws \
    PIPELINE_ROOT=/home/spark/spark-3dsg-pipeline \
    PYTHONUNBUFFERED=1 \
    DATA_TOOLS_ENV=/home/spark/.venvs/data-tools \
    PATH=/home/spark/.venvs/data-tools/bin:${PATH}

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN --mount=type=cache,id=apt-core-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-core-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      libcli11-dev \
      libeigen3-dev \
      libgoogle-glog-dev \
      libzmq3-dev \
      nlohmann-json3-dev \
      pipx \
      python3-pip \
      python3-pytest \
      python3-venv \
      python3-vcstool \
      python3-yaml \
      ros-dev-tools \
      ros-jazzy-rmw-fastrtps-cpp \
      ros-jazzy-rosbag2-storage-mcap

RUN rosdep init 2>/dev/null || true \
    && rosdep update --rosdistro ${ROS_DISTRO}

FROM base AS sources
WORKDIR ${ROS_WS}
COPY dependencies/locks/v1.lock.repos /tmp/v1.lock.repos
COPY scripts/shell/bootstrap_dependencies.sh /tmp/bootstrap_dependencies.sh
RUN /tmp/bootstrap_dependencies.sh ${ROS_WS}/src /tmp/v1.lock.repos

# Resolve dependencies from immutable upstream source and the local manifest.
# Launch/config edits must not invalidate package installation or compilation.
FROM base AS dependencies
RUN --mount=type=cache,id=apt-core-${TARGETARCH},target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lists-core-${TARGETARCH},target=/var/lib/apt/lists,sharing=locked \
    --mount=from=sources,source=/home/spark/ros_ws/src,target=/tmp/ros_src,ro \
    --mount=type=bind,source=src/spark_3dsg_pipeline/package.xml,target=/tmp/local_package/package.xml \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && rosdep install --from-paths /tmp/ros_src /tmp/local_package \
         --ignore-src -r -y --rosdistro ${ROS_DISTRO}

FROM dependencies AS builder
WORKDIR ${ROS_WS}
COPY --from=sources /home/spark/ros_ws/src /home/spark/ros_ws/src
COPY scripts/shell/build_workspace.sh /tmp/build_workspace.sh
RUN SPARK_BUILD_TESTING=OFF SPARK_SYMLINK_INSTALL=ON \
    /tmp/build_workspace.sh ${ROS_WS}

COPY src/spark_3dsg_pipeline src/spark_3dsg_pipeline
RUN SPARK_BUILD_TESTING=OFF SPARK_SYMLINK_INSTALL=ON \
    /tmp/build_workspace.sh ${ROS_WS} --packages-select spark_3dsg_pipeline

# Use the final system packages when creating a system-site-packages venv.
FROM dependencies AS data-tools
COPY dependencies/data-tools.requirements.txt /tmp/data-tools.requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m venv --system-site-packages "${DATA_TOOLS_ENV}" \
    && "${DATA_TOOLS_ENV}/bin/pip" install --upgrade pip \
    && "${DATA_TOOLS_ENV}/bin/pip" install \
         --requirement /tmp/data-tools.requirements.txt \
    && rosbags-convert --help >/dev/null

FROM dependencies AS runtime
ARG USER_UID=1000
ARG USER_GID=1000
# Match bind-mounted data/model/output ownership to the invoking host user.
RUN set -eux; \
    if getent group spark >/dev/null; then \
      groupmod --non-unique --gid "${USER_GID}" spark; \
    else \
      groupadd --non-unique --gid "${USER_GID}" spark; \
    fi; \
    if id spark >/dev/null 2>&1; then \
      usermod --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home /home/spark --shell /bin/bash spark; \
    else \
      useradd --non-unique --uid "${USER_UID}" --gid "${USER_GID}" \
        --home-dir /home/spark --create-home --shell /bin/bash spark; \
    fi; \
    install -d -o "${USER_UID}" -g "${USER_GID}" \
      /home/spark /home/spark/.cache /home/spark/.ros \
      /home/spark/data /home/spark/models /home/spark/output

# Preserve src/build/install at their original absolute paths: core deliberately
# uses symlink install and supports colcon tests and interactive development.
COPY --from=builder --chown=${USER_UID}:${USER_GID} \
    /home/spark/ros_ws /home/spark/ros_ws
COPY --from=data-tools --chown=${USER_UID}:${USER_GID} \
    /home/spark/.venvs /home/spark/.venvs
COPY --chown=${USER_UID}:${USER_GID} . ${PIPELINE_ROOT}
WORKDIR ${PIPELINE_ROOT}
RUN chmod +x docker/*.sh scripts/shell/*.sh scripts/python/*.py \
    && set +u \
    && source /opt/ros/${ROS_DISTRO}/setup.bash \
    && source ${ROS_WS}/install/setup.bash \
    && set -u \
    && ros2 pkg prefix hydra_ros \
    && ros2 pkg prefix khronos_ros \
    && ros2 pkg prefix spark_3dsg_pipeline \
    && python3 -c 'import spark_dsg' \
    && rosbags-convert --help >/dev/null \
    && ! find ${ROS_WS}/install -xtype l -print -quit | grep -q .

ENV HOME=/home/spark \
    XDG_CACHE_HOME=/home/spark/.cache
USER spark
RUN test -w "${HOME}" && test -w "${HOME}/.ros"

ENTRYPOINT ["/home/spark/spark-3dsg-pipeline/docker/ros_entrypoint.sh"]
CMD ["bash"]

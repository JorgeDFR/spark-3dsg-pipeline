# Independent future profile. Never merge this with adt4-public.repos.
repositories:
  daaam: {type: git, url: https://github.com/MIT-SPARK/DAAAM.git, version: main}
  daaam_ros: {type: git, url: https://github.com/MIT-SPARK/DAAAM-ROS.git, version: main}
  hydra: {type: git, url: https://github.com/MIT-SPARK/Hydra.git, version: project/daaam}
  hydra_ros: {type: git, url: https://github.com/MIT-SPARK/Hydra-ROS.git, version: project/daaam}
  spark_dsg: {type: git, url: https://github.com/MIT-SPARK/Spark-DSG.git, version: project/daaam}
  khronos: {type: git, url: https://github.com/nicogorlo/Khronos.git, version: main}
  config_utilities: {type: git, url: https://github.com/MIT-SPARK/config_utilities.git, version: main}
  ianvs: {type: git, url: https://github.com/MIT-SPARK/Ianvs.git, version: main}
  kimera_pgmo: {type: git, url: https://github.com/MIT-SPARK/Kimera-PGMO.git, version: ros2}
  kimera_rpgo: {type: git, url: https://github.com/MIT-SPARK/Kimera-RPGO.git, version: develop}
  pose_graph_tools: {type: git, url: https://github.com/MIT-SPARK/pose_graph_tools.git, version: ros2}
  semantic_inference: {type: git, url: https://github.com/MIT-SPARK/semantic_inference.git, version: main}
  spatial_hash: {type: git, url: https://github.com/MIT-SPARK/Spatial-Hash.git, version: main}
  teaser_plusplus: {type: git, url: https://github.com/MIT-SPARK/TEASER-plusplus.git, version: master}
  gtsam: {type: git, url: https://github.com/borglab/gtsam.git, version: release/4.2}
  small_gicp: {type: git, url: https://github.com/koide3/small_gicp.git, version: master}
  vision_opencv: {type: git, url: https://github.com/ros-perception/vision_opencv.git, version: rolling}

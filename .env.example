# Runtime container identity. Set these to the UID/GID of the host user that
# owns DATA_DIR, MODEL_DIR, and OUTPUT_DIR (`id -u` and `id -g`).
HOST_UID=1000
HOST_GID=1000

# Host paths mounted into containers. Relative paths are relative to this repo.
DATA_DIR=./data
MODEL_DIR=./models
OUTPUT_DIR=./output

# Integration package mounted over the symlink-built package in each image.
# Launch, configuration, and Python changes are therefore visible immediately.
PACKAGE_SOURCE_DIR=./src/spark_3dsg_pipeline

# ROS 2 defaults. Change the domain when sharing a network with other ROS systems.
ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Optional GUI forwarding for `make rviz`.
DISPLAY=:0
